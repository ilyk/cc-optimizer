# Server Configuration
NODE_ENV=development
PORT=3000

# Plaid API Credentials
# Get these from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
PLAID_ENV=sandbox

# Plaid Webhook (optional, for production)
PLAID_WEBHOOK_URL=https://your-domain.com/api/plaid/webhook
PLAID_WEBHOOK_VERIFICATION_KEY=your_webhook_key_here

# Database Configuration
# Use 'sqlite' for development or 'postgres' for production
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=./data/database.sqlite

# PostgreSQL Configuration (if using DATABASE_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cc_optimizer
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# Security Keys
# Generate strong random keys for production
JWT_SECRET=your_jwt_secret_here_change_this_in_production
ENCRYPTION_KEY=your_encryption_key_here_change_this_in_production

# JWT Configuration
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
