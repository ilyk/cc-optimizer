<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Disable cleartext traffic for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only system CAs, not user-installed CAs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Debug configuration - ONLY for local development -->
    <debug-overrides>
        <trust-anchors>
            <!-- In debug builds, also trust user CAs for development -->
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>

